# Скопируйте этот файл в .env и заполните значения:  cp .env.example .env
# docker compose автоматически читает .env из этого каталога.

# --- Обязательно ---
# Секрет для подписи JWT-токенов. Сгенерируйте один раз и не меняйте
# (смена разлогинит всех пользователей). Пример генерации:
#   openssl rand -hex 32
JWT_SECRET=

# --- Вариант A: за существующим nginx ---
# Имя docker-сети, в которой живёт ваш nginx (docker network ls).
# meshvoice-server подключится к ней, чтобы nginx резолвил его по имени.
PROXY_NETWORK=

# --- Вариант B: standalone c Caddy (docker compose --profile https up -d) ---
# Домен, указывающий A-записью на IP этого сервера (например DuckDNS-поддомен).
# Caddy выпустит на него Let's Encrypt-сертификат автоматически.
# (Для варианта A DOMAIN не нужен — TLS у nginx.)
DOMAIN=
