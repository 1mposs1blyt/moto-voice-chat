# Автоматический HTTPS для MeshVoice.
# Домен подставляется из переменной окружения DOMAIN (см. .env / docker-compose).
# Caddy сам выпустит и автоматически продлит сертификат Let's Encrypt.

{$DOMAIN} {
	# Проксируем на контейнер сервера по имени сервиса в docker-сети.
	reverse_proxy server:3000
}
